# Céntrate cloud API (apps/api). Copy to .env for local development; on Render set these in
# the dashboard (render.yaml creates the service). Never commit real values.
#
# Every feature is optional: a missing key switches its feature off cleanly (GET /health lists
# what is on and why the rest is off, and the routes answer 503 feature_disabled). A value that
# is set but malformed stops the server at boot with a message naming the variable.
# The desktop app works 100 % without this server.

# --- Server -----------------------------------------------------------------------------
# development | test | production (production requires https in BETTER_AUTH_URL).
NODE_ENV=development
# Render sets PORT itself. HOST defaults to 0.0.0.0.
PORT=3000
# fatal | error | warn | info | debug | trace | silent. At debug, each request line also counts
# the X-Forwarded-For entries (never the addresses): how TRUST_PROXY_HOPS is checked.
LOG_LEVEL=info
# Reverse proxies in front of the service. Render: 1 (check once, docs/API.md §12).
# Local: 0 (trust no X-Forwarded-For). Every per-IP limit depends on it.
TRUST_PROXY_HOPS=0

# --- Database (accounts, sync, friends, coach quotas) ------------------------------------
# Without it only /health works. Migrations run automatically at boot.
# Local example: docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17
DATABASE_URL=

# --- Accounts (better-auth) ---------------------------------------------------------------
# Both are needed for accounts. Secret: at least 32 random characters
# (openssl rand -base64 48). Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Public URL of this API, no trailing slash, e.g. https://centrate-api.onrender.com.
# Used for the Google callback ({URL}/api/auth/callback/google), email links and invite URLs.
BETTER_AUTH_URL=

# CORS allow-list, comma-separated origins (https://example.com). Empty = no cross-origin
# access. The desktop app does not need it (it calls from its main process).
APP_ORIGINS=

# --- Sign-in methods (at least one is needed for accounts) --------------------------------
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID → Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google. Scopes: openid email profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com) for sign-in codes and accountability-partner emails. EMAIL_FROM must use
# a domain verified in Resend: «Céntrate <hola@tu-dominio.com>».
RESEND_API_KEY=
EMAIL_FROM=
# Global cap on sign-in code emails per UTC day (default 50), kept below the Resend plan
# (the free plan allows about 100 emails a day, partner alerts included). Past it, email
# sign-in pauses until 00:00 UTC; Google sign-in keeps working. 0 = no sign-in emails.
SIGNIN_EMAILS_PER_DAY=50
# Global cap on accountability-partner emails (alerts and proposals) per UTC day, for all
# users together (default 40; each partner also gets at most 10 a day). Keep
# SIGNIN_EMAILS_PER_DAY + PARTNER_EMAILS_PER_DAY_GLOBAL under the Resend plan's daily quota
# (free plan: about 100), so partner alerts never use up the room for sign-in codes.
# 0 = no partner emails (the in-app inbox keeps working).
PARTNER_EMAILS_PER_DAY_GLOBAL=40

# --- Coach (Claude API) -------------------------------------------------------------------
# The key lives only here, never in the app. Without it the coach is off.
ANTHROPIC_API_KEY=
# Global kill switch: false turns every coach endpoint off at once.
AI_ENABLED=true
# Models (defaults shown): a fast cheap one for phrases, a capable one for the coach.
AI_MODEL_INTERPRET=claude-haiku-4-5
AI_MODEL_COACH=claude-opus-5
# Server-side refusal fallbacks (beta header server-side-fallback-2026-07-01) on the models
# that have them (claude-opus-5, claude-fable-5-1). Set to false if the API stops taking the
# beta (every coach call then fails and the coach switches itself off for 15 minutes).
AI_REFUSAL_FALLBACKS=true
# Per user per UTC day.
AI_USER_DAILY_INTERPRET_REQUESTS=30
AI_USER_DAILY_COACH_REQUESTS=10
AI_USER_DAILY_TOKENS=150000
# One user's (and one mailbox's) spend cap per UTC day in US dollars, both buckets, never above
# the global budget. Bounds one account's share of the global budget. A call needs room for its
# first hop (a study plan's is about 0.22 on claude-opus-5); its speculative fallback hop is
# held in the global budget only. The server warns at boot if an endpoint can never fit.
AI_USER_DAILY_BUDGET_USD=0.5
# Global spend cap per UTC day in US dollars; 0 turns the coach off.
AI_GLOBAL_DAILY_BUDGET_USD=2
