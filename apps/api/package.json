    "@fastify/rate-limit": "^11.2.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
