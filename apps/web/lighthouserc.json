{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/", "/descargar/", "/novedades/", "/privacidad/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
        ],
        "resource-summary:total:size": [
          "error",
          { "maxNumericValue": 1500000, "aggregationMethod": "pessimistic" }
        ],
        "resource-summary:media:size": [
          "error",
          { "maxNumericValue": 1200000, "aggregationMethod": "pessimistic" }
        ],
        "resource-summary:image:size": [
          "error",
          { "maxNumericValue": 360000, "aggregationMethod": "pessimistic" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/mobile"
    }
  }
}
